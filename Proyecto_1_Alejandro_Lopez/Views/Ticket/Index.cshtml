

@{
    ViewBag.Title = "Gestión de Tickets";

    int rol = Convert.ToInt32(Session["RolId"] ?? 0);
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Ticket</title>
</head>
<body>


    <div class="container mt-4">


        <h2 class="mb-4">Reporte</h2>

        @if (rol == 1)
        {

            <div class="row mb-4">


                <div class="col-md-3 mb-3">
                    <div class="card text-center shadow-sm p-3">
                        <h5>Tickets Abiertos</h5>
                        <h2 id="pTotalTicket">0</h2>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-center shadow-sm p-3">
                        <h5>Tickets En proceso</h5>
                        <h2 id="pendingTotalTicket">0</h2>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card text-center shadow-sm p-3">
                        <h5>Tickets Resueltos</h5>
                        <h2 id="totalTicket">0</h2>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-center shadow-sm p-3">
                        <h5>Tickets Cerradas</h5>
                        <h2 id="solveTotalTicket">0</h2>
                    </div>
                </div>


            </div>

        }

        <div class="mb-4">
            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#modalAgregarTicket">
                Agregar Ticket
            </button>
        </div>


        <div class="mb-3">
            <h4>Tickets agregados</h4>
        </div>
        <div class="row mb-3">

            <div class="col-md-6">
                <label>Buscar ticket</label>
                <input type="text"
                       id="filtroBusqueda"
                       class="form-control"
                       placeholder="Buscar por título o solicitante">
            </div>

            <div class="col-md-6">
                <label>Estado</label>
                <select id="filtroEstado" class="form-control">
                    <option value="">Todos</option>
                    <option value="1">Pendiente</option>
                    <option value="2">Abierto</option>
                    <option value="3">Cerrado</option>
                </select>
            </div>

        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>ID</th>
                        <th>Solicitante</th>
                        <th>Título</th>
                        <th>Descripción</th>
                        <th>Fecha creación</th>
                        <th>Usuario asignado</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody id="tablaTickets">
                </tbody>
            </table>
        </div>


    </div>


    <div class="modal fade" id="modalAgregarTicket" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Agregar ticket</h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <form id="formAgregarTicket">

                    <div class="modal-body">

                        <div class="mb-3">
                            <label>Título</label>
                            <input type="text" id="titulo"
                                   class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label>Descripción</label>
                            <textarea id="descripcion"
                                      class="form-control"
                                      required></textarea>
                        </div>

                        <div class="mb-3">
                            <label>Categoría</label>
                            <select id="categoria"
                                    class="form-select" required>
                            </select>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit" class="btn btn-primary">
                            Guardar ticket
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>






    <div class="modal fade"
         id="modalDetalleTicket"
         tabindex="-1"
         aria-labelledby="tituloModalDetalle"
         aria-hidden="true">

        <div class="modal-dialog modal-xl">
            <div class="modal-content">


                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModalDetalle">
                        Detalle del ticket
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">


                        <div class="col-md-5">

                            <h5>Comentarios</h5>
                            <hr />

                            <div id="listaComentarios"
                                 style="max-height:300px; overflow-y:auto;">
                                <p class="text-muted">
                                    Seleccione un ticket para ver comentarios.
                                </p>
                            </div>

                            <hr />

                           <form id="formComentario">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Agregar comentario</label>

        <textarea id="textoComentario"
                  class="form-control"
                  rows="3"
                  required></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Agregar comentario
    </button>
</form>

                        </div>


                        <div class="col-md-7">

                            <h5>Información del ticket</h5>
                            <hr />

                            <input type="hidden" id="idTicketDetalle" />

                            <div class="mb-3">
                                <label class="form-label">Título</label>
                                <input type="text"
                                       id="tituloDetalle"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Descripción</label>
                                <textarea id="descripcionDetalle"
                                          class="form-control"
                                          rows="3"
                                          readonly></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Categoría</label>

                                <select id="categoriaDetalle"
                                        class="form-select"
                                        disabled>
                                    <option value="">Seleccione...</option>
                                </select>
                            </div>

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Usuario asignado
                                    </label>

                                    <select id="usuarioAsignadoDetalle"
                                            class="form-select"
                                            @(rol != 1 ? "disabled" : "")>
                                        <option value="">Sin asignar</option>
                                    </select>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Estado del ticket
                                    </label>

                                    <select id="estadoDetalle"
                                            class="form-select"
                                            @(rol != 1 ? "disabled" : "")>
                                        <option value="">Seleccione...</option>
                                    </select>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>

                <!-- Pie del modal -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>

                    @if (rol == 1)
                    {
                        <button type="button"
                                id="btnActualizarTicket"
                                class="btn btn-success">
                            Guardar cambios
                        </button>
                    }

                </div>

            </div>
        </div>
    </div>




</body>
@section Scripts {
    <script src="@Url.Content("~/Scripts/JavaScript/Ticket.js")"></script>
  
}
</html>
