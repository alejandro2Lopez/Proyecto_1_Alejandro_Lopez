

@{
    ViewBag.Title = "Iniciar sesión";
}

<div class="container">
    <div class="row justify-content-center" style="margin-top: 100px;">
        <div class="col-md-5">

            <div class="card shadow-sm p-4">

                <h3 class="text-center mb-3">
                    Iniciar sesión
                </h3>

                <p class="text-center text-muted">
                    Sistema de Gestión de Tickets
                </p>

                <form id="formLogin">

                    <div class="mb-3">
                        <label class="form-label">
                            Correo electrónico
                        </label>
                        <input type="email"
                               id="email"
                               class="form-control"
                               placeholder="Ingrese su correo"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Contraseña
                        </label>
                        <input type="password"
                               id="password"
                               class="form-control"
                               placeholder="Ingrese su contraseña"
                               required />
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Ingresar
                    </button>

                </form>

            </div>

        </div>
    </div>
    @section Scripts {
        <script src="@Url.Content("~/Scripts/JavaScript/Login.js")"></script>
     
    }
</div>
